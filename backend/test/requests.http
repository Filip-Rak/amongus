}

###
# =========================
# REVIEWS
# =========================

@reviewProductId = 6a1ad2caa3073b4327610e1f
@reviewId = 6a057117273e9d6f5d06df3e
@adminReviewId = 6a0574464613c3f644e73dea

###
# Get all reviews for a product
# Public
# Params:
# - ?page=1&limit=20
GET {{baseUrl}}/products/{{reviewProductId}}/reviews

###
# Create review
# User
# Body fields:
# - rating: integer, 1-5, required
# - title: string, optional
# - comment: string, optional
POST {{baseUrl}}/products/{{reviewProductId}}/reviews
{{auth}}
{{json}}

{
	"rating": 4,
	"title": "Almost perfect.",
	"comment": "Well ventilated but lacks a cup holder."
}

###
# Update review
# User
# Body fields, all optional but at least one required:
# - rating: integer, 1-5
# - title: string
# - comment: string
PATCH {{baseUrl}}/reviews/{{reviewId}}
{{auth}}
{{json}}

{
	"rating": 4,
	"title": "Changed my mind",
	"comment": "Still good, but not perfect."
}

###
# Delete own review
# User
DELETE {{baseUrl}}/reviews/{{reviewId}}
{{auth}}

###
# Delete review as admin
# Admin
DELETE {{baseUrl}}/reviews/admin/{{adminReviewId}}
{{auth}}

