# - shippingAddress.fullName: string, required
# - shippingAddress.line1: string, required
# - shippingAddress.line2: string, optional
# - shippingAddress.city: string, required
# - shippingAddress.postalCode: string, required
# - shippingAddress.country: string, required
# - shippingAddress.phone: string, optional
POST {{baseUrl}}/orders/checkout
{{auth}}
{{json}}

{
	"shippingAddress": {
		"fullName": "Jan Kowalski",
		"line1": "Example Street 12",
		"city": "Warsaw",
		"postalCode": "00-001",
		"country": "Poland"
	}
}

###
# Checkout
# User
POST {{baseUrl}}/orders/checkout
{{auth}}
{{json}}

{
	"purchaseType": "company",
	"invoice": {
		"requested": true,
		"billingAddressSameAsShipping": false,
		"billingAddress": {
			"fullName": "ACME Sp. z o.o.",
			"line1": "Business Street 1",
			"city": "Warsaw",
			"postalCode": "00-002",
			"country": "Poland"
		},
		"companyDetails": {
			"companyName": "ACME Sp. z o.o.",
			"taxId": "1234567890"
		}
	},
	"shippingAddress": {
		"fullName": "Warehouse Receiver",
