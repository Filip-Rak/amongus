POST {{baseUrl}}/orders/checkout
{{auth}}
{{json}}

{
	"shippingAddress": 
	{
		"fullName": "Jan Kowalski",
		"line1": "Testowa 12",
		"city": "Warsaw",
		"postalCode": "00-001",
		"country": "Poland",
		"phone": "+48123123123"
	}
}

###
# Get orders
# User
GET {{baseUrl}}/orders/my
{{auth}}

###
# Get order
# User
GET {{baseUrl}}/orders/6a020cb567353eff5191ea4b
{{auth}}

# =========================
# Payments
# =========================

###
# Payment Success Mock
# User, Admin
POST {{baseUrl}}/payments/6a020cb567353eff5191ea4c/mock-success
{{auth}}

###
# Payment Failure Mock
# User, Admin
POST {{baseUrl}}/payments/6a020cb567353eff5191ea4c/mock-failure
{{auth}}

# =========================
# Reviews
# =========================

###
# Get all reviews for a product
# Public
GET {{baseUrl}}/products/6a01a26067dc2520bb700e7a/reviews

###
# Create review
# User
POST {{baseUrl}}/products/6a01a26067dc2520bb700e7a/reviews
{{auth}}
{{json}}

{
	"rating": 5,
	"title": "Good product",
	"comment": "Works as expected."
}

###
# Update review
# User
PATCH {{baseUrl}}/reviews/6a057117273e9d6f5d06df3e
{{auth}}
{{json}}

{
	"rating": 2,
	"title": "Changed my mind",
	"comment": "Bad"
}

###
# Delete review
# User
DELETE {{baseUrl}}/reviews/6a057117273e9d6f5d06df3e
{{auth}}

### Delete review
DELETE {{baseUrl}}/reviews/admin/6a0574464613c3f644e73dea
{{auth}}