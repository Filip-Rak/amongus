@paymentId = 6a1b344114ed3a45597557d2

###
# Payment success mock
# User, Admin
POST {{baseUrl}}/payments/{{paymentId}}/mock-success
{{auth}}

###
# Payment failure mock
# User, Admin
# Body fields:
