		"city": "Warsaw",
		"postalCode": "00-003",
		"country": "Poland",
		"phone": "+48123456789"
	}
}

###
# Get my orders
# User
GET {{baseUrl}}/orders/my
{{auth}}

###
# Get my order by id
# User
GET {{baseUrl}}/orders/{{orderId}}
