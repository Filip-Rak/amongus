@baseUrl = http://localhost:3001
@json = Content-Type: application/json
@auth = Authorization: Bearer {{login.response.body.$.accessToken}}

###
# =========================
# HEALTH
# =========================

###
# Health
GET {{baseUrl}}/health

###
# Database Health
GET {{baseUrl}}/health/db

###
# =========================
# AUTH
# Public
# =========================

###
# Register
# Public
POST {{baseUrl}}/auth/register
{{json}}

{
  "email": "user2@example.com",
  "password": "password123"
}

###
# @name login
# Public
POST {{baseUrl}}/auth/login
{{json}}

{
  "email": "admin1@example.com",
  "password": "password123"
}

###
# Me
# User, Admin
GET {{baseUrl}}/auth/me
{{auth}}

###
# =========================
# USERS
# User, Admin
# =========================

###
# Get all users
# Admin
GET {{baseUrl}}/users
{{auth}}

###
# Get one user
# Admin
GET {{baseUrl}}/users/69fc4f0c854dbf2bdd3f9295
{{auth}}

###
# Find me
# User, Admin
GET {{baseUrl}}/users/me
{{auth}}

###
# Create user
# Admin
POST {{baseUrl}}/users
{{auth}}
{{json}}

{
  "email": "admin2@example.com",
  "password": "password123",
  "role": "admin"
}

###
# Update me
# User, Admin
PATCH {{baseUrl}}/users/me
{{auth}}
{{json}}

{
  "email": "admin1@example.com",
  "currentPassword": "password123"
}

###
# Update user
# Admin
PATCH {{baseUrl}}/users/6a00c5798a197fe534142f20
{{auth}}
{{json}}

{
  "email": "admin2@example.com",
  "role": "admin",
  "status": "active"
}

###
# Delete user
# Admin
DELETE {{baseUrl}}/users/1
{{auth}}

###
# Remove self.
# User
DELETE {{baseUrl}}/users/me
{{auth}}