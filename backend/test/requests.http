@baseUrl = http://localhost:3001
@json = Content-Type: application/json
@auth = Authorization: Bearer {{login.response.body.$.accessToken}}

# Replace sample ids after creating resources in your local database.

###
# =========================
# HEALTH
# =========================

###
# Health
# Public
GET {{baseUrl}}/health

###
# Database Health
# Public
GET {{baseUrl}}/health/db

###
# =========================
# AUTH
# =========================

###
# Register
# Public
# Body fields:
# - email: string, email format, max 254
# - password: string, min 6, max 128
POST {{baseUrl}}/auth/register
{{json}}

{
	"email": "user1@example.com",
	"password": "password123"
}

###
# @name login
# Public
# Body fields:
# - email: string, email format, max 254
# - password: string, min 6, max 128
POST {{baseUrl}}/auth/login
{{json}}

{
	"email": "admin@example.com",
	"password": "password123"
}

###
# Me
# User, Admin
GET {{baseUrl}}/auth/me
{{auth}}

###
# =========================
# USERS
# =========================

@userId = 6a19ea4e358236d040e28b32

###
# Get all users
# Admin
# Params:
# - ?page=1&limit=20
# - ?role=user | admin
# - ?search=example@email.com
GET {{baseUrl}}/users
{{auth}}

###
# Get one user
# Admin
GET {{baseUrl}}/users/{{userId}}
{{auth}}

###
# Find me
# User, Admin
GET {{baseUrl}}/users/me
{{auth}}

###
# Create user
# Admin
# Body fields:
# - email: string, email format, max 254
# - password: string, min 6, max 128
# - role: user | admin, optional, defaults to user
POST {{baseUrl}}/users
{{auth}}
{{json}}

{
	"email": "user2@example.com",
	"password": "password123",
	"role": "user"
}

###
# Update me
# User, Admin
# Body fields:
# - email: string, optional
# - password: string, optional
# - currentPassword: string, required when changing email or password
PATCH {{baseUrl}}/users/me
{{auth}}
{{json}}

{
	"email": "user.updated@example.com",
	"password": "newPassword123",
	"currentPassword": "password123"
}

###
# Update user
# Admin
# Body fields, all optional but at least one required:
# - email: string
# - password: string, min 6, max 128
# - role: user | admin
# - status: active | deleted
PATCH {{baseUrl}}/users/{{userId}}
{{auth}}
{{json}}

{
	"email": "admin.updated@example.com",
	"password": "password123",
	"role": "admin",
	"status": "active"
}

###
# Soft delete user
# Admin
DELETE {{baseUrl}}/users/{{userId}}
{{auth}}

###
# Remove self
# User
DELETE {{baseUrl}}/users/me
{{auth}}

###
# =========================
# CATEGORIES
# =========================

@categoryId = 6a1acbd0a3073b4327610e18
@parentCategoryId = 6a1aab17be4f8dfeda905891
@categorySlug = keyboards

###
# List public categories
# Public
# Params:
# - ?page=1&limit=20
# - ?parentId=root
# - ?parentId={{categoryId}}
# - ?search=keyboard
# - public listing returns active categories only
GET {{baseUrl}}/categories

###
# List admin categories
# Admin
# Params:
# - ?page=1&limit=20
# - ?parentId=root
# - ?parentId={{categoryId}}
# - ?search=keyboard
# - ?status=active | archived
GET {{baseUrl}}/categories/admin
{{auth}}

###
# Get top-level active categories only
# Public
GET {{baseUrl}}/categories/root

###
# Get full active category tree
# Public
GET {{baseUrl}}/categories/tree

###
# Get category by id
# Admin
GET {{baseUrl}}/categories/admin/{{categoryId}}
{{auth}}

###
# Get category by id
# Public
GET {{baseUrl}}/categories/{{categoryId}}

###
# Get category by slug
# Public
GET {{baseUrl}}/categories/slug/{{categorySlug}}

###
# Get direct children of a category
# Public
GET {{baseUrl}}/categories/{{categoryId}}/children

###
# Get one category with its descendants as a subtree
# Public
GET {{baseUrl}}/categories/{{categoryId}}/tree

###
# Get inherited attribute definitions for a category
# Public
GET {{baseUrl}}/categories/{{categoryId}}/attributes

###
# Create root category
# Admin
# Body fields:
# - name: string, required
# - slug: string, optional; generated from name if omitted
# - parentId: Mongo ObjectId string, optional
# - description: string, optional
# - status: active only on create; archived is rejected
# - attributeDefinitions: array, optional
# Attribute definition fields:
# - key: string, required, lower_snake_case-like identifier
# - label: string, required
# - type: string | number | boolean | string_array
# - required: boolean
# - allowedValues: string[], optional; useful for string/string_array
# - min: number, optional; useful for number
# - max: number, optional; useful for number
# - unit: string, optional; useful for number
POST {{baseUrl}}/categories
{{auth}}
{{json}}

{
	"name": "RTV",
	"slug": "rtv",
	"description": "Electronics and home media products",
	"status": "active",
	"attributeDefinitions": [
		{
			"key": "brand",
			"label": "Brand",
			"type": "string",
			"isRequired": true,
			"allowedValues": [
				"Logitech",
				"Samsung",
				"Sony"
			]
		},
		{
			"key": "warranty_months",
			"label": "Warranty months",
			"type": "number",
			"isRequired": false,
			"min": 0,
			"max": 120,
			"unit": "months"
		},
		{
			"key": "wireless",
			"label": "Wireless",
			"type": "boolean",
			"isRequired": false
		},
		{
			"key": "tags",
			"label": "Tags",
			"type": "string_array",
			"isRequired": false,
			"allowedValues": [
				"gaming",
				"office",
				"portable"
			]
		}
	]
}

###
# Create child category
# Admin
# Same body fields as create root category.
# parentId makes this category inherit attributes from its ancestors.
POST {{baseUrl}}/categories
{{auth}}
{{json}}

{
	"name": "Keyboards",
	"slug": "keyboards",
	"parentId": "{{parentCategoryId}}",
	"description": "Mechanical and membrane keyboards",
	"status": "active",
	"attributeDefinitions": [
		{
			"key": "layout",
			"label": "Layout",
			"type": "string",
			"isRequired": true,
			"allowedValues": [
				"full-size",
				"TKL",
				"60%"
			]
		},
		{
			"key": "switch_type",
			"label": "Switch type",
			"type": "string",
			"isRequired": false,
			"allowedValues": [
				"red",
				"brown",
				"blue"
			]
		}
	]
}

###
# Update category
# Admin
# Body fields, all optional but at least one required:
# - name: string
# - slug: string
# - description: string
# - status: active | archived
# - attributeDefinitions: array; replaces current local category definitions
# parentId cannot be changed by this endpoint.
PATCH {{baseUrl}}/categories/{{categoryId}}
{{auth}}
{{json}}

{
	"name": "Keyboards",
	"slug": "keyboards",
	"description": "Mechanical, membrane and wireless keyboards",
	"status": "active",
	"attributeDefinitions": [
		{
			"key": "layout",
			"label": "Layout",
			"type": "string",
			"isRequired": true,
			"allowedValues": [
				"full-size",
				"TKL",
				"60%"
			]
		},
		{
			"key": "switch_type",
			"label": "Switch type",
			"type": "string",
			"isRequired": false,
			"allowedValues": [
				"red",
				"brown",
				"blue"
			]
		}
	]
}

###
# Archive category
# Admin
# Fails if category has child categories.
DELETE {{baseUrl}}/categories/{{categoryId}}
{{auth}}

###
# =========================
# PRODUCTS
# =========================

@productId = 6a1aae30be4f8dfeda905893
@productSlug = mechanical-keyboard-k87
@productCategoryId = 6a1aadabbe4f8dfeda905892

###
# Get public products
# Public
# Params:
# - ?page=1&limit=20
# - ?search=keyboard
# - ?categoryId={{productCategoryId}}
# - ?categoryId={{productCategoryId}}&includeSubcategories=true
# - ?minPrice=10000&maxPrice=40000
# - ?inStockOnly=true | false
# - public listing returns active products only
GET {{baseUrl}}/products

###
# Get public products of category and its subcategories
# Public
GET {{baseUrl}}/products?categoryId={{productCategoryId}}&includeSubcategories=true

###
# Get admin products
# Admin
# Params:
# - ?page=1&limit=20
# - ?search=keyboard
# - ?status=draft | active | archived
# - ?categoryId={{productCategoryId}}
# - ?categoryId={{productCategoryId}}&includeSubcategories=true
# - ?minPrice=10000&maxPrice=40000
# - ?inStockOnly=true | false
GET {{baseUrl}}/products/admin
{{auth}}

###
# Get product by id
# Admin
GET {{baseUrl}}/products/admin/{{productId}}
{{auth}}

###
# Get product by slug
# Public
GET {{baseUrl}}/products/slug/{{productSlug}}

###
# Get product by id
# Public
GET {{baseUrl}}/products/{{productId}}

###
# Create product
# Admin
# Body fields:
# - name: string, required
# - slug: string, optional; generated from name if omitted
# - description: string, required
# - categoryId: Mongo ObjectId string, required
# - price.amount: number, required, minor units, e.g. 29999 = 299.99 PLN
# - price.currency: PLN | EUR | USD
# - stock: number, required
# - images: array, optional; url, alt, isPrimary
# - attributeValues: object, optional; keys must be inherited from category attributes
# - status: draft | active; archived is rejected on create
POST {{baseUrl}}/products
{{auth}}
{{json}}

{
	"name": "Mechanical Keyboard K87",
	"slug": "mechanical-keyboard-k87",
	"description": "Compact hot-swappable mechanical keyboard.",
	"categoryId": "{{productCategoryId}}",
	"price": {
		"amount": 29999,
		"currency": "PLN"
	},
	"stock": 15,
	"images": [
		{
			"url": "https://i.ytimg.com/vi/ztyjepxO7mM/hqdefault.jpg",
			"alt": "Keyboard front view",
			"isPrimary": true
		}
	],
	"attributeValues": {
		"brand": "Logitech",
		"warranty_months": 24,
		"wireless": true,
		"tags": [
			"gaming",
			"office"
		],
		"layout": "TKL",
		"switch_type": "brown"
	},
	"status": "active"
}

###
# Update product
# Admin
# Body fields, all optional but at least one required:
# - name: string
# - slug: string
# - description: string
# - categoryId: Mongo ObjectId string
# - price: { amount, currency }
# - stock: number
# - images: array; replaces current images
# - attributeValues: object; replaces current product attribute values
# - status: draft | active | archived
PATCH {{baseUrl}}/products/{{productId}}
{{auth}}
{{json}}

{
	"name": "Mechanical Keyboard K87 Updated",
	"slug": "mechanical-keyboard-k87-updated",
	"description": "Updated compact hot-swappable mechanical keyboard.",
	"categoryId": "{{productCategoryId}}",
	"price": {
		"amount": 27999,
		"currency": "PLN"
	},
	"stock": 20,
	"images": [
		{
			"url": "https://i.ytimg.com/vi/ztyjepxO7mM/hqdefault.jpg",
			"alt": "Keyboard front view",
			"isPrimary": true
		}
	],
	"attributeValues": {
		"brand": "Logitech",
		"warranty_months": 24,
		"wireless": true,
		"tags": [
			"gaming"
		],
		"layout": "TKL",
		"switch_type": "brown"
	},
	"status": "active"
}

###
# Archive product
# Admin
DELETE {{baseUrl}}/products/{{productId}}
{{auth}}

###
# =========================
# CART
# =========================

@cartProductId = 6a1ad2caa3073b4327610e1f

###
# Get cart
# User
GET {{baseUrl}}/cart
{{auth}}

###
# Add to cart
# User
# Body fields:
# - productId: Mongo ObjectId string, required
# - quantity: integer, min 1, max 100
POST {{baseUrl}}/cart/items
{{auth}}
{{json}}

{
	"productId": "{{cartProductId}}",
	"quantity": 1
}

###
# Update existing cart item quantity
# User
# Body fields:
# - quantity: integer, min 1, max 100
PATCH {{baseUrl}}/cart/items/{{cartProductId}}
{{auth}}
{{json}}

{
	"quantity": 3
}

###
# Remove item from cart
# User
DELETE {{baseUrl}}/cart/items/{{cartProductId}}
{{auth}}

###
# Clear cart
# User
DELETE {{baseUrl}}/cart
{{auth}}

